# CATs M0 Rust 多阶段 Dockerfile 模板
# 引用: doc/02-基础设计/技术选型/CATs_技术基线_v1.0.md §1（基础镜像：distroless/cc-debian12）
# 引用: doc/02-基础设计/技术选型/CATs_Rust技术选型书_v1.0.md §14.2（容器化）
#
# 用法:
#   docker build -f deploy/docker/Dockerfile.rust \
#     --build-arg CRATE_NAME=auth-service \
#     --build-arg BIND_ADDR=0.0.0.0:8080 \
#     -t harbor.cats.internal/cats/auth-service:0.1.0 .
#
# 环境变量注入（数据库连接、Secret 等）由 K8s manifest 完成，不在 Dockerfile 硬编码。

# === Stage 1: builder ===
FROM rust:1.98.0-slim-bookworm AS builder

# CI 缓存优化：单独 COPY 依赖描述文件
WORKDIR /build

# 安装 protoc（tonic-build 编译期需要）
# Debian bookworm 仓库的 protobuf-compiler 默认 3.21+，满足 cats-proto 的所有 .proto
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        protobuf-compiler \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 先复制 workspace 元数据，让依赖编译独立缓存层
COPY Cargo.toml Cargo.lock ./
COPY .cargo ./.cargo
COPY rust-toolchain.toml ./

# 复制 proto 定义（必须！）
# crates/proto/build.rs 用 include path = workspace root (../..) 调用 protoc，
# 并以 "proto/cats/v1/common.proto" 这样的根相对路径引用互相 import。
# 漏掉这一层会让 build.rs 报：
#   protoc failed: Could not make proto path relative:
#   proto/cats/v1/common.proto: No such file or directory
# 放在 crates 之前：proto 变动频率远低于 crate 源码，便于分层缓存。
COPY proto ./proto

# 复制所有 crate 源码（注意：tonic-build 在 cats-proto/build.rs 中调用）
COPY crates ./crates

# 构建：整个 workspace 编一遍，与 CRATE_NAME 无关
#
# 2026-10-05 改版。原来这里是：
#     ARG CRATE_NAME
#     ENV CRATE_NAME=${CRATE_NAME}
#     RUN cargo build --release --bin ${CRATE_NAME} \
#         && strip target/release/${CRATE_NAME}
#
# 那一层的 cache key 里含 CRATE_NAME。而 ci-docker-build 是 17 个
# service 的 matrix，**每个 service 都有不同的 CRATE_NAME**，因此
# 17 个 job 的这一层 cache key 互不相同 → **每个都永远 miss**。
#
# 实测（run 37306407841，`docker build (ingestion-service)`，34.3 min）：
#     #26 [linux/amd64 builder 9/9] RUN cargo build --release --bin ingestion-service
#         144.5s   —— 真的跑了，不是 cache hit
#     #32 [linux/arm64 builder 9/9] RUN cargo build --release --bin ingestion-service
#         1425.3s  —— 同一步在 QEMU 模拟下，慢约 10 倍
# 全 job 34.3 min 里 33.8 min 全在这一步；17 service × 2 平台
# = 34 次完整 release 编译，缓存一次都命不中。
#
# 现在改成：与 CRATE_NAME 无关的一层编整个 workspace —— 17 个 job
# 共享同一个 cache key，只需真正编一次；「选哪个二进制」
# 下移成 runtime 阶段一次几乎零成本的 COPY。
RUN cargo build --release --workspace \
    && for f in target/release/*; do \
         if [ -f "$f" ] && [ -x "$f" ]; then strip "$f" || true; fi; \
       done

# === Stage 2: runtime ===
FROM gcr.io/distroless/cc-debian12:nonroot AS runtime

# 复制编译产物
ARG CRATE_NAME
COPY --from=builder /build/target/release/${CRATE_NAME} /usr/local/bin/${CRATE_NAME}

# distroless/cc-debian12:nonroot 镜像默认 UID 65532
# 不再显式 USER，由镜像默认 nonroot 账户承担

# 端口（业务实际端口由 Helm deployment.yaml 配 containerPort 决定）
EXPOSE 8080

# 入口点：仅传二进制，env 由 K8s 注入
ENTRYPOINT ["/usr/local/bin/${CRATE_NAME}"]
