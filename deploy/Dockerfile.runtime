# Multi-stage build: 编译所有 service binary,然后放到 runtime image
FROM rust:1.98.0 AS builder WORKDIR /app

# Pre-build common deps
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY proto ./proto

# Build all binaries in release mode
RUN cargo build --release --workspace --no-default-features 2>&1 | tail -20 || \
    (echo "FALLBACK: building only backend + aigw + bff"; \
     cargo build --release -p auth-service -p user-service -p project-service -p task-service \
        -p file-service -p notification-service -p report-service -p audit-service -p worker-service \
        -p translation-core -p cats-ai-gateway -p cats-bff -p cats-common -p cats-rbac 2>&1 | tail -30)

# Runtime image
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libssl3 libpq5 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binaries from builder
COPY --from=builder /app/target/release/auth-service         /usr/local/bin/
COPY --from=builder /app/target/release/user-service         /usr/local/bin/
COPY --from=builder /app/target/release/project-service      /usr/local/bin/
COPY --from=builder /app/target/release/task-service         /usr/local/bin/
COPY --from=builder /app/target/release/file-service         /usr/local/bin/
COPY --from=builder /app/target/release/notification-service /usr/local/bin/
COPY --from=builder /app/target/release/report-service       /usr/local/bin/
COPY --from=builder /app/target/release/audit-service        /usr/local/bin/
COPY --from=builder /app/target/release/worker-service       /usr/local/bin/
COPY --from=builder /app/target/release/translation-core     /usr/local/bin/
COPY --from=builder /app/target/release/cats-ai-gateway      /usr/local/bin/
COPY --from=builder /app/target/release/cats-bff             /usr/local/bin/

ENV RUST_LOG=info
EXPOSE 8080 8090 50051 50061

CMD ["/usr/local/bin/cats-bff"]