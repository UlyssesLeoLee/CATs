# Multi-stage build: 编译所有 service binary,然后放到 runtime image
# 注意: Dockerfile 一行只能有一条指令。原先这里是
#   FROM rust:1.98.0 AS builder WORKDIR /app
# 两���指令挤在一行，解析直接失败：
#   dockerfile parse error on line 2: FROM requires either one or three arguments
# 本文件此前从未被成功构建过——compose 的 dockerfile 路径先失败，
# 修好路径后才暴露出这个。
FROM rust:1.98.0 AS builder

# builder 阶段必须装 protobuf-compiler。
# crates/proto 的 build.rs 用 prost-build，它需要外部的 `protoc` 可执行文件，
# 而 rust:1.98.0（完整版，非 slim）**不带** protoc。
# 缺它的报错长这样：
#   Error: Custom { kind: NotFound, error: "Could not find `protoc`. ... }
#
# 这和 v0.2 修的 Dockerfile.rust 漏 `COPY proto ./proto` 是同一类问题
# （那次导致 ci-docker-build 9/17 镜像失败），只是发生在另一个文件上——
# Dockerfile.runtime 从没被构建过，所以同类缺陷一个都没修过。
# 已把 cache 挂到 /usr/local/cargo 以免每层都失效。
ENV CARGO_HOME=/usr/local/cargo
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Pre-build common deps
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY proto ./proto

# 显式列出 12 个 binary，与下方 COPY 列表一一对应。
#
# 原写法是
#     RUN cargo build --release --workspace --no-default-features 2>&1 | tail -20 || \
#         (echo "FALLBACK: ..."; cargo build ... -p cats-bff ...)
# 有两处问题，都是实测撞出来的：
#
#   1. **`| tail -20` 吃掉了 cargo 的退出码。** 管道的退出码是最后一个命令
#      （tail）的，tail 几乎总是返回 0，所以 `||` 那个显式列出 cats-bff
#      的 FALLBACK 分支**永远不会执行**。构建失败会被静默吞掉。
#   2. 结果就是编译报错被吞掉，RUN 步骤"成功"，等到后面
#      `COPY --from=builder /app/target/release/cats-bff` 才炸：
#        failed to calculate checksum: "/app/target/release/cats-bff": not found
#      报错指向 COPY，而真正的原因（cargo 的编译错误）早就被 tail 丢了。
#
# 改成显式 `-p` 列表：编译失败就直接失败，错误信息原样出现在构建日志里。
# 不再需要"失败后退而求其次"的分支——那 12 个 binary 缺任何一个，
# 运行时镜像就是残缺的。
RUN cargo build --release --no-default-features \
        -p auth-service -p user-service -p project-service -p task-service \
        -p file-service -p notification-service -p report-service \
        -p audit-service -p worker-service -p translation-core \
        -p cats-ai-gateway -p cats-bff

# Runtime image
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libssl3 libpq5 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binaries from builder
COPY --from=builder /app/target/release/auth-service         /usr/local/bin/
COPY --from=builder /app/target/release/user-service         /usr/local/bin/
COPY --from=builder /app/target/release/project-service      /usr/local/bin/
COPY --from=builder /app/target/release/task-service         /usr/local/bin/
COPY --from=builder /app/target/release/file-service         /usr/local/bin/
COPY --from=builder /app/target/release/notification-service /usr/local/bin/
COPY --from=builder /app/target/release/report-service       /usr/local/bin/
COPY --from=builder /app/target/release/audit-service        /usr/local/bin/
COPY --from=builder /app/target/release/worker-service       /usr/local/bin/
COPY --from=builder /app/target/release/translation-core     /usr/local/bin/
COPY --from=builder /app/target/release/cats-ai-gateway      /usr/local/bin/
COPY --from=builder /app/target/release/cats-bff             /usr/local/bin/

ENV RUST_LOG=info
EXPOSE 8080 8090 50051 50061

CMD ["/usr/local/bin/cats-bff"]