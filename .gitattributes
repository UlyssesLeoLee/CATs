# CATs M0 monorepo .gitattributes
# 跨平台行尾归一化：仓库内统一 LF；特定 Windows 必需文件用 CRLF

# 文本默认 LF
* text=auto eol=lf

# 显式锁定 LF
*.rs         text eol=lf
*.toml       text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.proto      text eol=lf
Dockerfile.* text eol=lf
*.sh         text eol=lf
*.tpl        text eol=lf

# Windows 必需 CRLF
*.bat        text eol=crlf
*.ps1        text eol=crlf
*.cmd        text eol=crlf

# 二进制不归一化
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.woff       binary
*.woff2      binary
*.ttf        binary
*.eot        binary

# License
LICENSE      text eol=lf
