{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "cats-client-web-preview",
  "public": false,
  "buildCommand": "npm --prefix apps/cats-client install --no-audit --no-fund && npm --prefix apps/cats-client run build",
  "outputDirectory": "apps/cats-client/dist",
  "installCommand": "echo skip-root-install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
